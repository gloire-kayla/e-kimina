{
  "expo": {
    "name": "e-Kimina",
    "slug": "e-kimina-mobile",
    "version": "0.7.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "rw.ekimina.mobile"
    },
    "android": {
      "package": "rw.ekimina.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#175c49"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/with-loopback-network.cjs",
      "./plugins/with-launcher-inset.cjs",
      "./plugins/with-short-android-build.cjs"
    ]
  }
}
